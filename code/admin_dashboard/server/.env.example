# ============================================================================
# RIDETRACE ADMIN PORTAL - BACKEND CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# Copy this file to server/.env and fill in your actual URLs and credentials.
# server/.env is ignored by Git (.gitignore) and is never pushed to GitHub.

PORT=5000
JWT_SECRET=replace_with_your_jwt_secret

# Primary Admin Credentials (SUPER_ADMIN)
ADMIN_EMAIL=admin@ridetrace.lk
ADMIN_PASSWORD=replace_with_admin_password
ADMIN_NAME=Primary Administrator

# Operator Credentials (OPERATOR)
OPERATOR_EMAIL=operator@ridetrace.lk
OPERATOR_PASSWORD=replace_with_operator_password
OPERATOR_NAME=Provisioning Operator

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
STORAGE_MODE=CLOUD

# 1. Firebase Realtime Database & Auth (Universal Email Verification)
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_DATABASE_SECRET=
FIREBASE_WEB_API_KEY=

# 2. Supabase PostgreSQL (Optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# SMTP VERIFICATION EMAIL DISPATCHER (OPTIONAL)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RideTrace Systems <no-reply@ridetrace.lk>"
